OPENFINANCE_ENV=dev
OPENFINANCE_LOG_LEVEL=INFO
OPENFINANCE_ENABLE_LIVE_TRADING=false
OPENFINANCE_TRADING_MODE=research
OPENFINANCE_KILL_SWITCH_ENABLED=false
OPENFINANCE_RISK_MAX_ORDER_QTY=10000
OPENFINANCE_LIVE_TRADING_UNLOCK_REQUIRED=true
OPENFINANCE_LLM_DEFAULT_PROVIDER=zhipu
OPENFINANCE_ZHIPU_MODEL=glm-4.7
OPENFINANCE_ZHIPU_API_KEY=
OPENFINANCE_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
OPENFINANCE_LLM_FORCE_STUB=true
OPENFINANCE_FACTOR_REGISTRY_DB_FILE=.openfinance/registry/factors.sqlite3
OPENFINANCE_FACTOR_ARTIFACT_ROOT=.openfinance/artifacts/factors
OPENFINANCE_APPROVAL_DB_FILE=.openfinance/registry/approvals.sqlite3
